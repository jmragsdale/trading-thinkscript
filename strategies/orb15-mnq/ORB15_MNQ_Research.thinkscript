# HYPOTHETICAL HISTORICAL RESEARCH ONLY — MNQ, one-minute time bars.
# No alerts, routing, credentials or live orders. Current incomplete bar is provisional.
# AddOrder markers occur one bar AFTER modeled fills; custom dollar ledger is authoritative.
# Native TOS compilation and export parity NOT verified. Read GUIDE.md.
declare upper;
input configuration = {default Original, StopCap100};
input historicalPath = {default HighFirst, LowFirst};
input showHypotheticalOrderMarkers = yes;
# Explicit prerequisite: period60000 alone also matches60000-tick charts.
input confirmedOneMinuteTimeChart = no;
def pointValue = 2.0;
def tick = 0.25;
def feeRT = 1.90;
def slip = 0.25;
def targetR = 5.0;
def capDistance = Floor(((100-feeRT-slip*pointValue)/pointValue)/tick)*tick;
def symbolOK = GetSymbol()=="/MNQ:XCME";
def validMinute = GetAggregationPeriod()==60000 and confirmedOneMinuteTimeChart and symbolOK;
# Explicit US post-2007 DST clock, avoiding ambiguous SecondsFromTime EST wording.
# GetYYYYMMDD is the instrument trading-session date, not a civil date; validate fixtures.
def sessionDate = GetYYYYMMDD();
def yr = Floor(sessionDate/10000);
def mo = Floor(sessionDate/100)-yr*100;
def dom = sessionDate-Floor(sessionDate/100)*100;
def marchSunday = 1+(7-GetDayOfWeek(yr*10000+301));
def novemberSunday = 1+(7-GetDayOfWeek(yr*10000+1101));
def daylight = mo>3 and mo<11 or mo==3 and dom>=marchSunday+7 or mo==11 and dom<novemberSunday;
def utcMinutes = Floor(GetTime()/60000)-Floor(GetTime()/86400000)*1440;
def etRaw = utcMinutes-(if daylight then 240 else 300);
def etMin = if etRaw<0 then etRaw+1440 else etRaw;
def newDay = sessionDate != sessionDate[1];
def inOR = etMin>=570 and etMin<585;
rec orHigh = CompoundValue(1, if newDay then (if inOR then high else Double.NaN) else if inOR then (if IsNaN(orHigh[1]) then high else Max(high,orHigh[1])) else orHigh[1], if inOR then high else Double.NaN);
rec orLow = CompoundValue(1, if newDay then (if inOR then low else Double.NaN) else if inOR then (if IsNaN(orLow[1]) then low else Min(low,orLow[1])) else orLow[1], if inOR then low else Double.NaN);
rec orBars = CompoundValue(1, if newDay then (if inOR then 1 else 0) else if inOR then orBars[1]+1 else orBars[1], if inOR then 1 else 0);
def ready = orBars==15 and orHigh>orLow;
# Single self-recursive state avoids mutually recursive entry/exit variables.
# State 0=flat unused, 1=flat used. Signed packed entry/stop ticks represent an open trade.
# Frozen MNQ domain: positive prices below250000; integers remain below2^53.
script PricePathStep {
    input priorCode = 0;
    input armed = no;
    input newDay = no;
    input o = 0.0;
    input h = 0.0;
    input l = 0.0;
    input rangeHigh = 0.0;
    input rangeLow = 0.0;
    input previousMinute = 0;
    input previousClose = 0.0;
    input capped = no;
    input highFirst = yes;
    def base = 1000000;
    def held = AbsValue(priorCode)>=base;
    def side = if priorCode>0 then 1 else -1;
    def oldEntry = Floor(AbsValue(priorCode)/base)*0.25;
    def oldStop = (AbsValue(priorCode)-Floor(AbsValue(priorCode)/base)*base)*0.25;
    def oldTarget = oldEntry+5*(oldEntry-oldStop);
    def eod = held and previousMinute>=959;
    # A stop submitted beyond the lastclose is activated, even ifnextopenreboundstohome.
    def marketableStopAtSubmission = held and side*(previousClose-oldStop)<=0;
    def gapStop = held and (marketableStopAtSubmission or side*(o-oldStop)<=0);
    def gapTarget = held and side*(o-oldTarget)>=0;
    def hitStop = held and (if side==1 then l<=oldStop else h>=oldStop);
    def hitTarget = held and (if side==1 then h>=oldTarget else l<=oldTarget);
    def targetFirst = if side==1 then highFirst else !highFirst;
    def chooseTarget = !eod and !gapStop and (gapTarget or hitTarget and (!hitStop or targetFirst));
    def exitNow = held and (eod or gapStop or gapTarget or hitStop or hitTarget);
    def rawExit = if eod or gapStop or gapTarget then o else if chooseTarget then oldTarget else oldStop;
    def exitPx = rawExit-(if chooseTarget then 0 else side*0.25);
    def activatedLong = previousClose>=rangeHigh;
    def activatedShort = previousClose<=rangeLow;
    def longTouch = h>=rangeHigh;
    def shortTouch = l<=rangeLow;
    def newSide = if activatedLong then 1 else if activatedShort then -1 else if o>=rangeHigh then 1 else if o<=rangeLow then -1 else if longTouch and shortTouch then (if highFirst then 1 else -1) else if longTouch then 1 else -1;
    def rawEntry = if activatedLong or activatedShort then o else if newSide==1 then Max(o,rangeHigh) else Min(o,rangeLow);
    def newEntry = rawEntry+newSide*0.25;
    def originalStop = if newSide==1 then rangeLow else rangeHigh;
    def oldR = newSide*(newEntry-originalStop);
    def newR = if capped then Min(oldR,48.75) else oldR;
    def newStop = newEntry-newSide*newR;
    def domainOK = newR>0 and newEntry>0 and newEntry<250000 and newStop>0 and newStop<250000;
    def newPacked = newSide*(Round(newEntry/0.25,0)*base+Round(newStop/0.25,0));
    def candidate = priorCode==0 and armed and (activatedLong or activatedShort or longTouch or shortTouch);
    plot RejectedUnsupported = candidate and !domainOK;
    plot NextCode = if held then (if exitNow then 1 else priorCode) else if newDay then 0 else if candidate then (if domainOK then newPacked else 1) else priorCode;
    plot ExitPrice = if exitNow then exitPx else Double.NaN;
}
def armed = validMinute and yr>=2007 and !newDay and ready[1] and etMin[1]>=585 and etMin[1]<959;
def highFirst = historicalPath==historicalPath.HighFirst;
rec modelCode = CompoundValue(1, PricePathStep(priorCode=modelCode[1],armed=armed,newDay=newDay,o=open,h=high,l=low,rangeHigh=orHigh[1],rangeLow=orLow[1],previousMinute=etMin[1],previousClose=close[1],capped=configuration==configuration.StopCap100,highFirst=highFirst).NextCode, 0);
def rejectedGeometry = PricePathStep(priorCode=modelCode[1],armed=armed,newDay=newDay,o=open,h=high,l=low,rangeHigh=orHigh[1],rangeLow=orLow[1],previousMinute=etMin[1],previousClose=close[1],capped=configuration==configuration.StopCap100,highFirst=highFirst).RejectedUnsupported;
rec unsupportedCases = CompoundValue(1,unsupportedCases[1]+(if rejectedGeometry then 1 else 0),0);
def heldBefore = AbsValue(modelCode[1])>=1000000;
def heldAfter = AbsValue(modelCode)>=1000000;
def entryEvent = heldAfter and !heldBefore;
def exitEvent = heldBefore and !heldAfter;
def entrySide = if modelCode>0 then 1 else -1;
def priorSide = if modelCode[1]>0 then 1 else -1;
def entryPrice = Floor(AbsValue(modelCode)/1000000)*0.25;
def stopPrice = (AbsValue(modelCode)-Floor(AbsValue(modelCode)/1000000)*1000000)*0.25;
def targetPrice = entryPrice+5*(entryPrice-stopPrice);
def priorEntry = Floor(AbsValue(modelCode[1])/1000000)*0.25;
def modeledExitPrice = PricePathStep(priorCode=modelCode[1],armed=armed,newDay=newDay,o=open,h=high,l=low,rangeHigh=orHigh[1],rangeLow=orLow[1],previousMinute=etMin[1],previousClose=close[1],capped=configuration==configuration.StopCap100,highFirst=highFirst).ExitPrice;
def closedNet = if exitEvent then priorSide*(modeledExitPrice-priorEntry)*pointValue-feeRT else 0;
rec netLedger = CompoundValue(1, netLedger[1]+closedNet, 0);
rec trades = CompoundValue(1, trades[1]+(if exitEvent then 1 else 0), 0);
# These are next-bar hypothetical records at retrospectively modeled prices, not fills.
AddOrder(OrderType.BUY_TO_OPEN, showHypotheticalOrderMarkers and entryEvent and entrySide==1, entryPrice, 1, Color.CYAN, Color.CYAN, "RESEARCH L — shifted marker");
AddOrder(OrderType.SELL_TO_OPEN, showHypotheticalOrderMarkers and entryEvent and entrySide==-1, entryPrice, 1, Color.MAGENTA, Color.MAGENTA, "RESEARCH S — shifted marker");
AddOrder(OrderType.SELL_TO_CLOSE, showHypotheticalOrderMarkers and exitEvent and priorSide==1, modeledExitPrice, 1, Color.YELLOW, Color.YELLOW, "RESEARCH exit — shifted marker");
AddOrder(OrderType.BUY_TO_CLOSE, showHypotheticalOrderMarkers and exitEvent and priorSide==-1, modeledExitPrice, 1, Color.YELLOW, Color.YELLOW, "RESEARCH exit — shifted marker");
plot OpeningHigh = if ready then orHigh else Double.NaN;
plot OpeningLow = if ready then orLow else Double.NaN;
plot HypotheticalStop = if heldAfter then stopPrice else Double.NaN;
plot HypotheticalTarget = if heldAfter then targetPrice else Double.NaN;
OpeningHigh.SetDefaultColor(Color.CYAN);
OpeningLow.SetDefaultColor(Color.MAGENTA);
HypotheticalStop.SetDefaultColor(Color.ORANGE);
HypotheticalTarget.SetDefaultColor(Color.GREEN);
AddLabel(yes, "HYPOTHETICAL MNQ ONLY | " + (if configuration==configuration.Original then "Original" else "Frozen StopCap100") + " | no routing; latest bar provisional", Color.YELLOW);
AddLabel(yes, "Custom net $"+Round(netLedger,2)+" | closed trades "+trades+" | AddOrder markers shifted one bar", Color.WHITE);
AddLabel(!validMinute, "DISABLED: /MNQ:XCME and confirmed one-minute TIME chart required | "+GetSymbol(), Color.RED);
AddLabel(unsupportedCases>0,"INCOMPLETE MODEL: "+unsupportedCases+" inverted/out-of-domain entries rejected; do not rank net",Color.RED);
AddLabel(yes, "Frozen cap 48.75 pts; entry bar unprotected; loss may exceed $100", Color.ORANGE);
