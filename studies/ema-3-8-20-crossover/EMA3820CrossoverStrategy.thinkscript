#My3820EMACrossover

declare upper;

input price = close;
input EMA1 = 3;
input EMA2 = 8;
input EMA3 = 20;
input EMA4 = 50;
input SMA5 = 50;
input displace = 0;
input showBreakoutSignals = no;

#EMA Cloud 
def emaLength1 = ExpAverage(close, EMA1);
def emaLength2 = ExpAverage(close, EMA2);
AddCloud(emaLength1, emaLength2, Color.green, Color.pink);
def emaLength3 = ExpAverage(close, EMA3);
def emaLength4 = ExpAverage(close, EMA4);
AddCloud(emaLength3, emaLength4, Color.cyan, Color.red);

#SMA
plot SMA = Average(price[-displace], SMA5);
SMA.SetPaintingStrategy(PaintingStrategy.line);
SMA.SetLineWeight(5);
SMA.SetDefaultColor(Color.dark_orange);

def emaValue1 = movavgExponential (close, EMA1);
def emaValue2 = movavgExponential (close, EMA2);
def emaValue3 = movavgExponential (close, EMA3);
def emavalue4 = movAvgExponential (close, EMA4);

def CrossoverUp1 = emaValue1 [1] < emaValue2 [1] and emaValue1 > emaValue2;
def CrossoverDn1 = emaValue1 [1] > emaValue2 [1] and emaValue1 < emaValue2;
def Diff1 = emavalue1 - emavalue2;

def CrossoverUp2 = emaValue1 [1] < emaValue3 [1] and emaValue1 > emaValue3;
def CrossoverDn2 = emaValue1 [1] > emaValue3 [1] and emaValue1 < emaValue3;
def Diff2 = emavalue1 - emavalue3;

def CrossoverUp3 = emaValue3 [1] < emaValue4 [1] and emaValue3 > emaValue4;
def CrossoverDn3 = emaValue3 [1] > emaValue4 [1] and emaValue3 < emaValue4;
def Diff4 = emavalue3 - emavalue4;

# EMA3 and EMA8 Crossover

Plot ArrowUp1 = if emaValue1 crosses above emaValue2
then low
else double.nan;
Arrowup1.SetPaintingStrategy(PaintingStrategy.points);
ArrowUp1.SetLineWeight(3);
ArrowUp1.SetDefaultColor(Color.white);
plot ArrowDN1 = if emaValue1 crosses below emaValue2
then high
else double.nan;
ArrowDN1.SetPaintingStrategy(PaintingStrategy.points);
ArrowDN1.SetLineWeight(3);
ArrowDN1.SetDefaultColor(Color.white);

AddLabel(emavalue1 > emavalue2, "3>8|$" + Round(Diff1,4), Color.Green);
AddLabel(emavalue1 < emavalue2, "8>3|$" + Round(Diff1,4), Color.Red);

